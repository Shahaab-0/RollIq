# Server-side only (never exposed to the browser -- no NEXT_PUBLIC_ prefix).
# Every request from the browser goes through this app's own /api/proxy
# route, which attaches the access token server-side and forwards here.
BACKEND_URL=http://localhost:8080/api/v1

# Client-visible (NEXT_PUBLIC_ prefix required for the browser bundle to see
# it). Same host as BACKEND_URL but without the /api/v1 suffix -- used only
# to link to the backend's public, unauthenticated /legal/*.html pages.
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8080
