# iOS simulator can reach the host machine at localhost.
# Android emulator cannot -- use 10.0.2.2 instead (it's an alias to the host).
API_BASE_URL=http://localhost:8080/api/v1

# Optional -- leave blank to disable crash/error reporting entirely (the SDK
# no-ops with an empty DSN). Get a DSN from sentry.io (free tier): sign up,
# create a React Native project, copy the DSN it gives you.
SENTRY_DSN=
