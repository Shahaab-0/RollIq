# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# We don't use `use_frameworks!` (see below), which defaults CocoaPods to
# static linkage -- react-native-firebase's SPM-based Firebase resolution
# only supports dynamic linkage, so it collides with duplicate symbols at
# link time otherwise. This opts react-native-firebase back onto plain
# CocoaPods-resolved Firebase pods instead, which is compatible with our
# static (non-use_frameworks!) setup.
$RNFirebaseDisableSPM = true

platform :ios, min_ios_version_supported
prepare_react_native_project!

# FirebaseCoreInternal (Swift) depends on GoogleUtilities, which doesn't
# define modules -- required for Swift pods to build as static libraries.
use_modular_headers!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'RollIQ' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
